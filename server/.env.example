# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/mechway?retryWrites=true&w=majority

# JWT Secret - Generate a random string for security
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string

# Admin Key for accessing admin panel
ADMIN_KEY=your_admin_secret_key_for_admin_panel

# Razorpay Payment Gateway (Optional)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Server Port
PORT=4000

# SendZen WhatsApp (Optional)
SENDZEN_API_KEY=your_sendzen_api_key
SENDZEN_WHATSAPP_FROM=your_sendzen_sender_id
SENDZEN_BASE_URL=https://api.sendzen.io

# Password reset OTP: enable Google 2-Step Verification and create a Gmail App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mechwaysupport@gmail.com
SMTP_PASS=
MAIL_FROM=MechWay <mechwaysupport@gmail.com>
PASSWORD_RESET_BASE_URL=https://www.mechway.in

# Telegram alerts for new bookings, contacts, and restoration requests
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public backend origin serving /uploads/restoration/* vehicle photos
RESTORATION_ASSET_BASE_URL=https://newonwheels.onrender.com
PUBLIC_BASE_URL=https://www.mechway.in
